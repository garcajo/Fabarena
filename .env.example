# =============================================================================
# FAB Arena Frontend - Environment Variables
# =============================================================================

# API URL - Backend server
# Development: http://localhost:3000/api
# Production: https://your-backend.railway.app/api
VITE_API_URL=http://localhost:3000/api

# Supabase Configuration (for client-side auth)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# EmailJS Configuration (Contact Form)
# Get these from your EmailJS dashboard: https://dashboard.emailjs.com/admin
VITE_EMAILJS_SERVICE_ID=your_service_id
VITE_EMAILJS_TEMPLATE_ID=your_template_id
VITE_EMAILJS_PUBLIC_KEY=your_public_key
